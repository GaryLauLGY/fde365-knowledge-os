{"id": "KB-KB-INGEST-001", "rule": "先定位当前知识库配置，再读取资料。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-002", "rule": "只加载当前任务需要的资产。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-003", "rule": "区分事实、用户陈述、推断和未知。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-004", "rule": "关键结论返回来源路径。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-005", "rule": "原始材料保持不变。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-006", "rule": "批量写入、移动、覆盖和删除先确认。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-007", "rule": "不跨客户或跨项目读取。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-008", "rule": "资料不足时完成证据允许的部分。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-009", "rule": "不能确认的分类进入待确认区。", "source": "kb-suite-owned-workflow-v1"}
{"id": "KB-KB-INGEST-010", "rule": "交付后说明写入位置和未完成项。", "source": "kb-suite-owned-workflow-v1"}
