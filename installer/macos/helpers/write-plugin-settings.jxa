ObjC.import("Foundation");

function readJson(path) {
  try {
    const text = $.NSString.stringWithContentsOfFileEncodingError(
      path,
      $.NSUTF8StringEncoding,
      null,
    );
    return JSON.parse(ObjC.unwrap(text));
  } catch (_) {
    return {};
  }
}

function writeJson(path, value) {
  const text = JSON.stringify(value, null, 2) + "\n";
  const output = $.NSString.alloc.initWithUTF8String(text);
  if (!output.writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null)) {
    throw new Error("无法写入插件配置");
  }
}

function run(argv) {
  const path = argv[0];
  const model = argv[1];
  if (!path || !model) throw new Error("插件配置参数不完整");

  const settings = readJson(path);
  settings.schemaVersion = 5;
  settings.onboardingVersion = Number(settings.onboardingVersion || 0);
  settings.ai = settings.ai && typeof settings.ai === "object" ? settings.ai : {};
  settings.ai.provider = "fde365";
  settings.ai.fde365 = settings.ai.fde365 && typeof settings.ai.fde365 === "object"
    ? settings.ai.fde365
    : {};
  // 登录凭证由插件邮箱登录后保存；安装器不接收凭证。
  settings.ai.fde365.model = model;
  settings.ai.fde365.temperature = 0.3;
  settings.ai.fde365.timeoutMs = 120000;
  writeJson(path, settings);
  return "ok";
}
