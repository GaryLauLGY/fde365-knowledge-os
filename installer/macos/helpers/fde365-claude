#!/bin/bash
set -Eeuo pipefail
IFS=$'\n\t'

FDE365_SUPPORT="$HOME/Library/Application Support/FDE365 Knowledge OS"

find_claude() {
  for candidate in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude" "$(command -v claude 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
  done
  return 1
}

CLAUDE_BIN="$(find_claude)" || { printf '尚未安装 Claude Code，请重新运行 FDE365 安装器。\n' >&2; exit 1; }
exec "$CLAUDE_BIN" "$@"
