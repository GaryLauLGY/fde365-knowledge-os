ObjC.import("Foundation");

function readJson(path) {
  try {
    const text = $.NSString.stringWithContentsOfFileEncodingError(
      path,
      $.NSUTF8StringEncoding,
      null,
    );
    return JSON.parse(ObjC.unwrap(text));
  } catch (_) {
    return {};
  }
}

function writeJson(path, value) {
  const text = JSON.stringify(value, null, 2) + "\n";
  const output = $.NSString.alloc.initWithUTF8String(text);
  if (!output.writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null)) {
    throw new Error("无法登记知识库");
  }
}

function run(argv) {
  const path = argv[0];
  const vaultPath = argv[1];
  const vaultId = argv[2];
  const timestamp = Number(argv[3]);
  if (!path || !vaultPath || !vaultId || !timestamp) throw new Error("知识库登记参数不完整");

  const config = readJson(path);
  config.vaults = config.vaults && typeof config.vaults === "object" ? config.vaults : {};
  Object.keys(config.vaults).forEach((key) => {
    if (config.vaults[key] && typeof config.vaults[key] === "object") config.vaults[key].open = false;
  });
  config.vaults[vaultId] = { path: vaultPath, ts: timestamp, open: true };
  writeJson(path, config);
  return "ok";
}
