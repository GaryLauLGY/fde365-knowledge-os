ObjC.import("Foundation");

function run(argv) {
  const path = argv[0];
  if (!path) throw new Error("缺少插件配置路径");
  const text = $.NSString.stringWithContentsOfFileEncodingError(
    path,
    $.NSUTF8StringEncoding,
    null,
  );
  const settings = JSON.parse(ObjC.unwrap(text));
  const token = String(settings?.ai?.fde365?.token || "").trim();
  if (!token) throw new Error("FDE365 Token 尚未配置");
  return token;
}
